# 이 파일을 apps/web/.env.local로 복사하고 로컬에서 입력합니다.
# 실제 키와 DB 비밀번호는 Git 또는 채팅에 올리지 않습니다.
# 초기 화면과 공통 명세 테스트는 아래 값 없이 실행할 수 있습니다.
# 이 예제의 실제 키 값은 항상 비워 둡니다.
# 배포 키는 Vercel 환경변수의 Secret 유형으로 환경별 등록합니다(SDD 6.5).

# Supabase URL과 Publishable key는 브라우저에 공개되는 설정입니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 아래 값은 서버 전용입니다. NEXT_PUBLIC_ 접두사를 붙이지 않습니다.
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
# 초기 평가 모델입니다. 실제 기록 생성 품질을 확인한 뒤 운영에 사용합니다.
GEMINI_MODEL=gemini-3.1-flash-lite
# 공공데이터포털 일반 인증키(Decoding)를 입력합니다.
TAGO_SERVICE_KEY=
