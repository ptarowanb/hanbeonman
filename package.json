{
  "name": "hanbeonman",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "pnpm --filter @hanbeonman/web dev",
    "build": "pnpm --filter @hanbeonman/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "secrets:check": "node scripts/check-secrets.mjs",
    "secrets:test": "node --test scripts/check-secrets.test.mjs",
    "supabase:test": "node --test scripts/supabase-schema.test.mjs",
    "secrets:install-hooks": "node scripts/setup-hooks.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
